<Project Sdk="Transpose.Build.Target/26.9.4870">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The three theme projects must not build at the same time. Each one's tps run compiles Tesserae
         as a dependency with settings that differ from Tesserae's own build, so the first of them always
         rewrites Tesserae/bin/.../tss.dll, and two doing it at once fail with TPS0004 (file in use).
         Tesserae.sln orders them the same way (Curiosity, Stratus, RetroOS) for a solution build. -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.9.5840" />
    <PackageReference Include="Transpose.Core" Version="26.9.5838" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tesserae\Tesserae.csproj" />
    <ProjectReference Include="..\Tesserae.Themes.Curiosity\Tesserae.Themes.Curiosity.csproj" />
    <ProjectReference Include="..\Tesserae.Themes.Stratus\Tesserae.Themes.Stratus.csproj" />
    <ProjectReference Include="..\Tesserae.Themes.RetroOS\Tesserae.Themes.RetroOS.csproj" />
  </ItemGroup>
</Project>
