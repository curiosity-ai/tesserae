<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Linked rather than referenced: Tesserae is a Transpose project and cannot be consumed by
         a plain console app, and packing with a different implementation than the one that
         unpacks at runtime is exactly the bug this tool exists to avoid. -->
    <Compile Include="../Tesserae/src/Helpers/PackedText.cs" />
  </ItemGroup>
</Project>
