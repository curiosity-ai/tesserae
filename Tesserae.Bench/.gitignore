# Build output
bin/
obj/

# playwright/node_modules is a symlink to whatever Node install the machine has —
# see the README for how to point it at yours.
playwright/node_modules

# Captured artefacts: screenshots, .cpuprofile traces and result JSON. These are
# large (tens of MB per run) and are regenerated by every run.
playwright/out/

# Scratch probes. Anything written to answer one question and thrown away goes in a file named
# _something.js, so it never ends up committed alongside the harness.
playwright/_*.js
